@{
entrypoint_config = {
    'rosdistroIndexUrl': rosdistro_index_url,
    'rosdistroName': rosdistro_name,
    'releaseBuildName': release_build_name,
    'pkgName': pkg_name,
    'debianPkgName': debian_package_name,
    'osName': os_name,
    'osCodeName': os_code_name,
    'arch': arch,
    'repositoryUrls': repository_urls,
    'repositoryKeys': repository_keys,
    'targetRepository': target_repository,
    'rosBuildfarmRepoUrl': ros_buildfarm_repository.url,
    'rosBuildfarmRepoVersion': ros_buildfarm_repository.version,
    'importPackageJobName': import_package_job_name,
    'credentialId': credential_id,
    'uploadHost': vars().get('upload_host') or 'repo',
    'nodeLabel': node_label,
    'timeoutMinutes': timeout_minutes,
    'dockerMode': docker_mode,
    'dockerBaseImageOverride': vars().get('docker_base_image_override'),
    'prebakedBaseImage': bool(vars().get('prebaked_base_image', False)),
    'orchestrationMode': orchestration_mode,
    'triggerSyncOnComplete': orchestration_mode == 'reverse-trigger',
    'childProjects': list(child_projects or []),
    'sharedCcache': bool(shared_ccache),
    'envVars': list(build_environment_variables or []),
    'skipTests': bool(skip_tests),
    'skipRosdepKeys': list(skip_rosdep_keys or []),
    'appendTimestamp': bool(append_timestamp),
}
parameters = [
    {
        'type': 'boolean',
        'name': 'skip_cleanup',
        'description': 'Skip cleanup of build artifacts',
    },
]
}@
@(TEMPLATE(
    'release/pipeline_utility_job.xml.em',
    source_template_name=template_name,
    now_str=now_str,
    disabled=disabled,
    github_url=github_url,
    job_priority=job_priority,
    parameters=parameters,
    upstream_projects=upstream_projects,
    orchestration_mode=orchestration_mode,
    pipeline_shared_library=pipeline_shared_library,
    entrypoint_name='rosReleaseBinaryDeb',
    entrypoint_config=entrypoint_config,
))@
